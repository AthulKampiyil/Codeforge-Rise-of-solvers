# Production Environment Variables

# --- Domain & Routing ---
PUBLIC_HOST=codeforge.example.com
FRONTEND_URL=https://codeforge.example.com
VITE_API_BASE_URL=https://codeforge.example.com

# --- Database (PostgreSQL) ---
POSTGRES_USER=codeforge
POSTGRES_PASSWORD=generate_a_secure_password_here
POSTGRES_DB=codeforge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Security & Tokens ---
SECRET_KEY=generate_a_secure_random_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Judge Adapters ---
JUDGE_MODE=real
CODEFORCES_API_BASE=https://codeforces.com/api
CODEFORCES_RATE_LIMIT_PER_SEC=0.5

# --- Sync scheduling ---
SYNC_POLL_INTERVAL_MINUTES=360
ONDEMAND_SYNC_COOLDOWN_SECONDS=300
DLQ_SWEEP_MINUTES=15

# --- Worker ---
WORKER_TICK_SECONDS=30
