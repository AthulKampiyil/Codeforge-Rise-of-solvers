body { margin: 0; background: #0d1117; }
a { color: #c9a227; text-decoration: none; }
a:hover { color: #e0bb44; }
.wf, .wf * { box-sizing: border-box; }
.wf { background:#0d1117; color:#e6e9ee; font-family: ui-sans-serif, system-ui, "Segoe UI", Helvetica, Arial, sans-serif; font-size:13px; line-height:1.45; display:flex; flex-direction:column; overflow:hidden; }
.mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; }
.disp { font-family: Georgia, "Times New Roman", serif; }
.muted { color:#8b96a5; } .dim { color:#5c6673; } .gold { color:#c9a227; }
.ok { color:#4ac97f; } .bad { color:#c94a4a; } .inf { color:#4a90c9; }
.row { display:flex; gap:14px; } .col { display:flex; flex-direction:column; gap:14px; }
.kicker { font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:#5c6673; }
.sect-t { font-family:Georgia,serif; font-size:20px; color:#e6e9ee; }
.nav { flex:0 0 56px; display:flex; align-items:center; gap:26px; padding:0 22px; background:#0f151d; border-bottom:1px solid #2a323d; }
.brand { font-family:Georgia,serif; font-size:15px; letter-spacing:.2em; text-transform:uppercase; color:#c9a227; }
.nav-links { display:flex; gap:20px; align-items:center; }
.nav-links span { font-size:12px; letter-spacing:.08em; text-transform:uppercase; color:#8b96a5; padding:19px 0 17px; border-bottom:2px solid transparent; }
.nav-links span.on { color:#c9a227; border-bottom-color:#c9a227; }
.nav-right { margin-left:auto; display:flex; align-items:center; gap:14px; }
.panel { background:#141a22; border:1px solid #2a323d; border-radius:4px; display:flex; flex-direction:column; }
.panel-h { display:flex; align-items:center; gap:10px; padding:10px 14px; border-bottom:1px solid #2a323d; flex:0 0 auto; }
.panel-t { font-family:Georgia,serif; font-size:11.5px; letter-spacing:.16em; text-transform:uppercase; color:#8b96a5; }
.panel-b { padding:14px; display:flex; flex-direction:column; gap:12px; overflow:hidden; }
.pill { display:inline-flex; align-items:center; gap:6px; padding:3px 9px; border-radius:999px; border:1px solid #2a323d; font-size:11px; letter-spacing:.04em; color:#8b96a5; background:#0f151d; white-space:nowrap; }
.dot { width:6px; height:6px; border-radius:50%; display:block; flex:0 0 6px; }
.btn { display:inline-flex; align-items:center; justify-content:center; gap:7px; height:34px; padding:0 14px; border-radius:4px; border:1px solid #2a323d; background:#1a222c; color:#e6e9ee; font-size:12.5px; letter-spacing:.04em; white-space:nowrap; }
.btn-gold { background:#c9a227; border-color:#c9a227; color:#14100a; font-weight:600; }
.btn-ghost { background:transparent; color:#8b96a5; }
.btn-danger { border-color:#c94a4a; color:#c94a4a; background:transparent; }
.btn-off { opacity:.42; }
.btn-sm { height:27px; padding:0 10px; font-size:11.5px; }
.bar { height:6px; background:#0f151d; border:1px solid #2a323d; border-radius:2px; overflow:hidden; }
.bar > i { display:block; height:100%; background:#c9a227; }
.tile { flex:1; background:#141a22; border:1px solid #2a323d; border-radius:4px; padding:11px 14px; display:flex; flex-direction:column; gap:3px; }
.tile-l { font-size:10px; letter-spacing:.14em; text-transform:uppercase; color:#5c6673; }
.tile-v { font-family:ui-monospace,Menlo,monospace; font-size:23px; color:#e6e9ee; letter-spacing:-0.01em; }
.wt { width:100%; border-collapse:collapse; }
.wt th { font-size:10px; letter-spacing:.14em; text-transform:uppercase; color:#5c6673; text-align:left; padding:8px 12px; border-bottom:1px solid #2a323d; font-weight:600; }
.wt td { padding:9px 12px; border-bottom:1px solid rgba(42,50,61,.5); font-size:12.5px; }
.wt tr.me td { background:rgba(201,162,39,.07); }
.field { display:flex; flex-direction:column; gap:6px; }
.input { height:36px; border:1px solid #2a323d; background:#0f151d; border-radius:4px; padding:0 11px; display:flex; align-items:center; color:#8b96a5; font-size:12.5px; }
.tabs { display:flex; gap:20px; border-bottom:1px solid #2a323d; padding:0 14px; }
.tabs span { font-size:11.5px; letter-spacing:.1em; text-transform:uppercase; color:#5c6673; padding:11px 0 9px; border-bottom:2px solid transparent; }
.tabs span.on { color:#e6e9ee; border-bottom-color:#c9a227; }
.avatar { width:34px; height:34px; border-radius:4px; border:1px solid #2a323d; background:#1a222c; display:flex; align-items:center; justify-content:center; font-family:Georgia,serif; color:#c9a227; font-size:13px; }
