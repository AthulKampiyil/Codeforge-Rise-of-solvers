# Copy to .env and fill in. Never commit the real .env.

# --- Database (PostgreSQL) ---
POSTGRES_USER=codeforge
POSTGRES_PASSWORD=codeforge
POSTGRES_DB=codeforge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Security & Tokens (NFR-3.2, REQ-1.6) ---
SECRET_KEY=changeme
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Judge Adapters (Codeforces only — see plan.md) ---
JUDGE_MODE=mock            # mock | real — dev uses mock adapters (SADD 11.1)
CODEFORCES_API_BASE=https://codeforces.com/api
CODEFORCES_RATE_LIMIT_PER_SEC=0.5   # CF allows ~1 request / 2s

# --- Sync scheduling (resolves SRS Appendix C TBD-7) ---
SYNC_POLL_INTERVAL_MINUTES=360
ONDEMAND_SYNC_COOLDOWN_SECONDS=300  # REQ-2.2: once per 5 min per judge account
DLQ_SWEEP_MINUTES=15

# --- Worker ---
WORKER_TICK_SECONDS=30

# Note: game-balance values (attack cooldown, matchmaking tolerances,
# trophy K-factors, league thresholds, territory hysteresis, circuit
# breaker thresholds) are NOT env vars — they live in the
# game_balance_config table (M9, UC-12) so an Admin can tune them live.
# See plan.md Phase 1 seed data for defaults.
